# ============================================================================
# O CÓDIGO DO SILÊNCIO — variáveis de ambiente
# Copie este arquivo para ".env.local" e preencha os valores reais.
# Nenhuma dessas variáveis deve ser *secreta* no sentido de credenciais de
# backend sensíveis — todas são lidas no cliente ou em rotas públicas.
# ============================================================================

# URL do checkout da Kiwify. Todos os botões de compra usam esta variável.
NEXT_PUBLIC_KIWIFY_CHECKOUT_URL="https://pay.kiwify.com.br/gPJXKem"

# Preço exibido do produto, em formato decimal (ponto como separador).
# Usado apenas para exibição — a cobrança real acontece na Kiwify.
NEXT_PUBLIC_PRICE="29.90"

# Preço "de" opcional, para comparação. Deixe vazio para não exibir nenhum
# comparativo de preço. Só preencha com um valor real e comprovável.
NEXT_PUBLIC_PRICE_COMPARE=""

# ID do Meta Pixel.
NEXT_PUBLIC_META_PIXEL_ID="1406287875905767"

# Nome do produto (usado em metadados, Open Graph e eventos).
NEXT_PUBLIC_PRODUCT_NAME="O Código do Silêncio"

# URL pública do site (para metadados Open Graph e canonical).
NEXT_PUBLIC_SITE_URL="https://seu-dominio.vercel.app"

# ----------------------------------------------------------------------------
# Painel administrativo (/admin) — protegido por senha simples via cookie.
# Defina uma senha forte antes de publicar em produção.
# ----------------------------------------------------------------------------
ADMIN_PASSWORD="troque-esta-senha"

# ----------------------------------------------------------------------------
# Webhook da Kiwify (confirmação real de pagamento -> evento Purchase).
# Token usado para validar que a notificação recebida em
# /api/webhooks/kiwify realmente vem da Kiwify (configurado no painel da
# Kiwify, em Webhooks). Sem isso, o endpoint rejeita a notificação.
# ----------------------------------------------------------------------------
KIWIFY_WEBHOOK_TOKEN=""

# ----------------------------------------------------------------------------
# Meta Conversions API (opcional, recomendado para deduplicar o evento
# Purchase enviado pelo Pixel do navegador). Sem essas credenciais, o
# Purchase ainda é confirmado via webhook, mas não é replicado para a CAPI.
# ----------------------------------------------------------------------------
META_CONVERSIONS_API_ACCESS_TOKEN=""
META_CONVERSIONS_API_TEST_EVENT_CODE=""
